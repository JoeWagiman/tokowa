# Base URL API backend obrool (tanpa slash di akhir).
# Contoh: https://obrool.com  atau  http://localhost:3000
OBROOL_API_BASE=

# Publik, aman untuk sisi klien (dipakai untuk deep link & QR chat).
NEXT_PUBLIC_WA_NUMBER=
NEXT_PUBLIC_APP_URL=http://localhost:3001

# URL dashboard obrool untuk tombol "Lanjut daftar di obrool".
NEXT_PUBLIC_OBROOL_URL=https://obrool.com

# Mode waitlist: "true" (default) menampilkan form waitlist di halaman
# masuk/daftar; "false" menampilkan form login dan pendaftaran akun.
NEXT_PUBLIC_WAITLIST_MODE=true

# Endpoint server untuk menerima form waitlist (mis. Google Apps Script,
# Formspree, n8n). Form di halaman masuk/daftar mengirim ke sini lewat BFF.
# Kosong = form menampilkan "Pendaftaran belum dibuka".
WAITLIST_FORWARD_URL=

# Jangan menaruh nilai secret di berkas ini. Daftar nama variabel saja.
